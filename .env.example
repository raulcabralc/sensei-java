# Variáveis de ambiente do Sensei (backend Java).
# Copie para um arquivo local (ex.: .env) e preencha. Arquivos .env reais NÃO devem ser versionados.
# Atenção: o Spring Boot NÃO carrega arquivos .env automaticamente. Informe estas variáveis
# na Run Configuration do IntelliJ (campo "Environment variables") ou no seu shell.

# Perfil Spring: dev (desenvolvimento local) ou prod.
SPRING_PROFILES_ACTIVE=dev

# URI de conexão do MongoDB.
# Obrigatória no perfil prod. No perfil dev, se vazia/ausente, usa mongodb://localhost:27017/sensei
MONGODB_URI=

# Segredo HMAC para assinar os JWT. Obrigatório em todos os perfis.
# Mínimo de 32 bytes (32 caracteres ASCII). Gere um valor aleatório próprio, por exemplo:
#   Git Bash / Linux / macOS:  openssl rand -base64 48
JWT_SECRET=

# Validade do token em milissegundos (opcional). Padrão: 86400000 (24 horas). Máximo: 2147483647.
JWT_EXPIRATION_MS=86400000

# Chave da API OpenAI (transcrição e resumo).
# Obrigatória no perfil prod. No perfil dev pode ficar vazia: a aplicação inicia,
# mas os endpoints /ai/** falham.
OPENAI_API_KEY=
